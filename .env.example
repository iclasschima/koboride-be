DATABASE_URL="postgresql://kobo:kobo@localhost:5432/koboride"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="14d"

BASE_FEE_NGN="400"
PER_KM_FEE_NGN="250"
MIN_FARE_NGN="650"
YABA_FLAT_FEE_NGN="1000"
ONLINE_PAYMENT_DISCOUNT_NGN="50"
MAX_DELIVERY_DISTANCE_KM="10"
PLATFORM_CUT_PERCENT="15"

# Optional. Localhost / 127.0.0.1 any port is already allowed.
CORS_ORIGIN="http://localhost:3000"

ADMIN_EMAIL="admin@koboride.ng"
ADMIN_PASSWORD="ChangeMeNow!"

# Places API (New) — server only. Enable it in Google Cloud Console.
GOOGLE_PLACES_API_KEY=""

# Customer can cancel until pickup, up to this many times in the rolling window.
MAX_CANCELS_PER_WINDOW="3"
CANCEL_WINDOW_HOURS="24"

# Default live orders per customer. Admin → Settings can raise this without a redeploy.
MAX_ACTIVE_ORDERS="3"

# Paystack — card/transfer. Use test keys locally.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Cloudinary — rider photos and optional delivery-proof photos.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Web Push (npx web-push generate-vapid-keys). Public key must match NEXT_PUBLIC_VAPID_PUBLIC_KEY on the frontend.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@koboride.ng"
