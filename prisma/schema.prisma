generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  dispatching
  in_progress
  completed
  cancelled
}

enum RiderPhase {
  accepted
  en_route_pickup
  collected
  en_route_dropoff
  delivered
}

enum RiderAvailability {
  OFFLINE
  ONLINE
}

enum CustomerRole {
  sender
  receiver
}

enum PaymentMethod {
  cash
  paystack
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum RiderIdType {
  nin
  drivers_license
  voters_card
  passport
}

model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  active    Boolean  @default(true)
  cancelLimitResetAt DateTime?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Rider {
  id           String            @id @default(cuid())
  phone        String            @unique
  name         String
  photoUrl     String?
  idType       RiderIdType?
  idNumber     String?
  idDocumentUrl String?
  nextOfKinName String?
  nextOfKinPhone String?
  nextOfKinRelationship String?
  approved     Boolean           @default(false)
  availability RiderAvailability @default(OFFLINE)
  /** Dedicated dispatch pool. One zone per rider — never cross-dispatch. */
  zoneSlug     String            @default("YAB")
  createdAt    DateTime          @default(now())
  orders       Order[]
  releases     OrderRelease[]

  @@index([zoneSlug])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/** Neighborhood bicycle coverage. Dispatch never crosses zones; adjacent hops are allowed. */
model PricingZone {
  slug          String   @id
  name          String
  centerLat     Float
  centerLng     Float
  radiusKm      Float
  active        Boolean  @default(false)
  adjacentSlugs String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  pinId     String?
  codeHash  String?
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

enum PushRole {
  customer
  rider
  admin
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  role      PushRole
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  @@index([userId, role])
}

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(dispatching)
  riderPhase  RiderPhase?

  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  riderId     String?
  rider       Rider?      @relation(fields: [riderId], references: [id])

  pickup      String
  pickupLat   Float
  pickupLng   Float
  dropoff     String
  dropoffLat  Float
  dropoffLng  Float
  /** Dispatch pool for this order (pickup zone, or pickup zone on an adjacent hop). */
  zoneSlug    String      @default("YAB")
  notes       String?

  senderName     String   @default("")
  senderPhone    String   @default("")
  receiverName   String   @default("")
  receiverPhone  String   @default("")
  customerRole   CustomerRole @default(sender)
  /** Who settles the fare in cash — sender at pickup or receiver at drop-off. */
  farePayer      CustomerRole @default(sender)

  feeNgn      Int
  payoutNgn   Int
  payoutPaid  Boolean     @default(false)
  paymentMethod PaymentMethod @default(cash)
  paymentStatus PaymentStatus @default(unpaid)
  paystackReference String? @unique
  paystackRefundId String?
  paidAt      DateTime?
  refundedAt  DateTime?
  /** Road distance pickup → dropoff, stored at quote time (km). */
  distanceKm  Float       @default(0)

  deliveryPin String
  deliveryPinRevealedAt DateTime?
  deliveryPinRequestedAt DateTime?
  deliveryProof String?
  deliveryProofNote String?
  deliveryProofPhotoUrl String?

  cancelReason String?

  /** When set in the future, order is paused from rider dispatch until that time. */
  scheduledFor    DateTime?
  /** @deprecated Customer reschedule delay — kept for existing rows. */
  rescheduleCount Int       @default(0)
  /** Cancel-intercept retention offer has been shown (or applied). */
  retentionOfferShown Boolean @default(false)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  completedAt DateTime?

  releases    OrderRelease[]
  events      OrderEvent[]

  @@index([status, scheduledFor])
  @@index([zoneSlug, status, scheduledFor])
}

/** Audit trail for order lifecycle (reschedule, auto-cancel, schedule activate, …). */
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/** One row each time a rider hands a job back before pickup. */
model OrderRelease {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId   String
  rider     Rider       @relation(fields: [riderId], references: [id], onDelete: Cascade)
  /** Phase the job was in when the rider dropped it. */
  phase     RiderPhase?
  reason    String
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@index([riderId, createdAt])
}
