generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  dispatching
  in_progress
  completed
  cancelled
}

enum RiderPhase {
  accepted
  en_route_pickup
  collected
  en_route_dropoff
  delivered
}

enum RiderAvailability {
  OFFLINE
  ONLINE
}

enum CustomerRole {
  sender
  receiver
}

enum PaymentMethod {
  cash
  paystack
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum RiderIdType {
  nin
  drivers_license
  voters_card
  passport
}

enum OnboardingStatus {
  SUBMITTED
  ID_VERIFIED
  APPROVED
  REJECTED
}

/// How a customer first reached KoboRide.
enum CustomerSource {
  /// Signed in on the KoboRide site with a code.
  app
  /// Ordered from a shop's menu link.
  shop_link
  /// A shop sent them a bag.
  shop_bag
  /// Ops booked an order for them.
  admin
}

model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  active    Boolean  @default(true)
  cancelLimitResetAt DateTime?
  /// Set once, when the account is created. Null for accounts from before this was recorded.
  source           CustomerSource?
  /// The shop that brought them, for shop_link and shop_bag.
  sourceMerchantId String?
  sourceMerchant   Merchant? @relation("CustomerSourceMerchant", fields: [sourceMerchantId], references: [id], onDelete: SetNull)
  /// First link tag seen in the browser before sign-up: ?ref=, or utm_source / utm_medium / utm_campaign.
  sourceRef        String?
  /// First KoboRide page the browser opened, e.g. /m/tyme-out.
  sourceLanding    String?
  /// Site that linked to that first page, e.g. instagram.com.
  sourceReferrer   String?
  createdAt DateTime @default(now())
  orders    Order[]

  @@index([sourceMerchantId])
}

model Rider {
  id           String            @id @default(cuid())
  phone        String            @unique
  name         String
  photoUrl     String?
  idType       RiderIdType?
  idNumber     String?
  idDocumentUrl String?
  nextOfKinName String?
  nextOfKinPhone String?
  nextOfKinRelationship String?
  approved     Boolean           @default(false)
  availability RiderAvailability @default(OFFLINE)
  /** Last GPS fix from the rider app, sent while online or on a job. Shown on the admin live map. */
  lastLat        Float?
  lastLng        Float?
  lastLocationAt DateTime?
  /** Dedicated dispatch pool. One zone per rider — never cross-dispatch. */
  zoneSlug     String            @default("YAB")
  onboardedByAgentId String?
  onboardedByAgent   Agent?            @relation(fields: [onboardedByAgentId], references: [id])
  onboardingStatus   OnboardingStatus  @default(SUBMITTED)
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectionReason    String?
  /** Set once, when completed deliveries first reach 10. Never overwritten. */
  firstTenReachedAt  DateTime?
  idVerified         Boolean           @default(false)
  bankName           String?
  /** Paystack bank code from the bank list. Required before a transfer recipient can be created. */
  bankCode           String?
  /** AES-GCM ciphertext. Lookup uses idNumberLookup, never this column. */
  bankAccountNo      String?
  /** Name returned by Paystack resolve. Not the name the agent typed. */
  bankAccountName    String?
  bankVerifiedAt     DateTime?
  paystackRecipientCode String?
  bankNeedsReview    Boolean           @default(false)
  idNumberLookup     String?           @unique
  photoWithBikeUrl   String?
  selfieUrl          String?
  depositPaid        Boolean           @default(false)
  createdAt    DateTime          @default(now())
  orders       Order[]
  releases     OrderRelease[]
  onboardingEvents OnboardingEvent[]
  ledgerEntries LedgerEntry[]
  payouts      Payout[]

  @@index([zoneSlug])
  @@index([onboardedByAgentId])
  @@index([onboardingStatus, submittedAt])
}

enum AdminRole {
  super
  staff
}

/** What a staff admin may open. A super admin has all of them. */
enum AdminPermission {
  orders
  users
  shops
  riders
  agents
  payouts
  payments
  settings
}

model Admin {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  passwordHash String
  role         AdminRole         @default(super)
  permissions  AdminPermission[]
  /** Super admins confirm refunds and team changes with this PIN. */
  pinHash      String?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  refunds      Refund[]
  shopPayouts  ShopPayout[]
}

/** A refund an admin sent from the Payments tab. */
model Refund {
  id               String   @id @default(cuid())
  reference        String
  amountNgn        Int
  reason           String
  adminId          String
  admin            Admin    @relation(fields: [adminId], references: [id])
  orderId          String?
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paystackRefundId String?
  createdAt        DateTime @default(now())

  @@index([reference])
}

/** Field agent. Provisioned by admin; never self-registered. */
model Agent {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  riders    Rider[]
  payouts   AgentPayout[]
}

/// Whether the menu link takes orders: by the order hours, or always open / closed until changed.
enum ShopOpenMode {
  hours
  open
  closed
}

/** A shop with one pickup. Customers order from its public link, or the shop sends a bag. */
model Merchant {
  id        String     @id @default(cuid())
  phone     String     @unique
  name      String
  slug      String     @unique
  address   String     @default("")
  lat       Float?
  lng       Float?
  active    Boolean    @default(true)
  /// Set by an admin. Until then the shop can set up its menu but cannot send bags or take link orders.
  approvedAt DateTime?
  /// Who pays delivery on menu-link orders: the shop at pickup, or the customer at drop-off.
  deliveryPayer CustomerRole @default(receiver)
  /// Menu-link order hours as "HH:MM" Lagos time. Both null means always open; closing before opening runs past midnight.
  opensAt  String?
  closesAt String?
  /// Set by the shop. open and closed ignore the hours until the shop switches back.
  openMode ShopOpenMode @default(hours)
  /// Numbers shown on the shop link. Calls fall back to the sign-in phone; WhatsApp is hidden when empty.
  callPhone     String?
  whatsappPhone String?
  /// How many different bags one link order can contain. 1 means a single bag.
  maxBags       Int         @default(1)
  /// Where KoboRide pays out card-paid menu orders.
  bankName        String?
  bankCode        String?
  /** AES-GCM ciphertext. */
  bankAccountNo   String?
  /** Name returned by Paystack resolve. */
  bankAccountName String?
  /// Paystack transfer recipient for the saved account. Cleared when the account changes.
  paystackRecipientCode String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
  orders    Order[]
  payouts   ShopPayout[]
  customers Customer[] @relation("CustomerSourceMerchant")
}

model MenuItem {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  priceNgn   Int
  available  Boolean  @default(true)
  /// Added to every link order at least once, e.g. a takeaway pack.
  required   Boolean  @default(false)
  sort       Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([merchantId, available])
}

/** One row. Amounts are kobo. Admin edits these; earnings code only reads them. */
model AgentPayConfig {
  id                 String @id @default("default")
  activationPay      Int    @default(250000)
  volumeBonusPer10   Int    @default(500000)
  retentionBonus     Int    @default(1000000)
  retentionThreshold Float  @default(0.7)
  activityWindowDays Int    @default(14)
  baseStipend        Int    @default(3000000)
  transportAllowance Int    @default(1000000)
  updatedAt          DateTime @updatedAt
}

/** Manual payroll record. One payout per agent per month. */
model AgentPayout {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  month     String
  amount    Int
  reference String
  createdAt DateTime @default(now())

  @@unique([agentId, month])
  @@index([agentId])
}

model OnboardingEvent {
  id        String   @id @default(cuid())
  riderId   String
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  actorId   String
  actorRole String
  action    String
  note      String?
  createdAt DateTime @default(now())

  @@index([riderId, createdAt])
}

/** Append-only rider balance. Credits are positive kobo, debits are negative. */
model LedgerEntry {
  id             String   @id @default(cuid())
  riderId        String
  rider          Rider    @relation(fields: [riderId], references: [id])
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id])
  type           String
  amount         Int
  idempotencyKey String   @unique
  payoutId       String?
  payout         Payout?  @relation(fields: [payoutId], references: [id])
  note           String?
  createdBy      String
  createdAt      DateTime @default(now())

  @@index([riderId, createdAt])
  @@index([payoutId])
}

model PayoutRun {
  id         String    @id @default(cuid())
  runDate    String    @unique
  status     String
  cutoffAt   DateTime
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    Json?
  payouts    Payout[]
}

model Payout {
  id                   String        @id @default(cuid())
  runId                String
  run                  PayoutRun     @relation(fields: [runId], references: [id])
  riderId              String
  rider                Rider         @relation(fields: [riderId], references: [id])
  grossEarnings        Int
  recovered            Int
  amount               Int
  reference            String        @unique
  status               String
  paystackTransferCode String?
  failureReason        String?
  attempts             Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  entries              LedgerEntry[]

  @@index([runId])
  @@index([riderId, status])
}

/** One row. Amounts are kobo. Admin edits these. */
model PayoutConfig {
  id                 String @id @default("default")
  cutoffHourLagos    Int    @default(21)
  runHourLagos       Int    @default(22)
  minPayout          Int    @default(50000)
  recoveryCapRatio   Float  @default(0.5)
  maxAttempts        Int    @default(3)
  cashDebtBlockLimit Int    @default(200000)
  /** platform | rider. Default: KoboRide bears a refund after confirmation. */
  refundCostBearer   String @default("platform")
  updatedAt          DateTime @updatedAt
}

model ReconciliationRun {
  id        String   @id @default(cuid())
  runDate   String
  status    String
  details   Json
  createdAt DateTime @default(now())

  @@index([runDate])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/** A business pin with a fixed fare for pickup, drop-off, or both. Customers see the name and price, not the address. */
model LocationOffer {
  id                   String   @id @default(cuid())
  name                 String
  address              String
  lat                  Float
  lng                  Float
  feeNgn               Int
  pickup               Boolean  @default(false)
  dropoff              Boolean  @default(false)
  /** How many non-cancelled orders each customer can book at this price. Null means no limit. */
  maxUsesPerCustomer   Int?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  pickupOrders         Order[]  @relation("PickupOffer")
  dropoffOrders        Order[]  @relation("DropoffOffer")
}

/** Neighborhood bicycle coverage. Dispatch never crosses zones; adjacent hops are allowed. */
model PricingZone {
  slug          String   @id
  name          String
  centerLat     Float
  centerLng     Float
  radiusKm      Float
  active        Boolean  @default(false)
  adjacentSlugs String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  pinId     String?
  codeHash  String?
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

enum PushRole {
  customer
  rider
  admin
  merchant
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  role      PushRole
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  @@index([userId, role])
}

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(dispatching)
  riderPhase  RiderPhase?

  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  riderId     String?
  rider       Rider?      @relation(fields: [riderId], references: [id])

  pickup      String
  pickupLat   Float
  pickupLng   Float
  dropoff     String
  dropoffLat  Float
  dropoffLng  Float
  pickupOfferId  String?
  pickupOffer    LocationOffer? @relation("PickupOffer", fields: [pickupOfferId], references: [id], onDelete: SetNull)
  dropoffOfferId String?
  dropoffOffer   LocationOffer? @relation("DropoffOffer", fields: [dropoffOfferId], references: [id], onDelete: SetNull)
  /** Dispatch pool for this order (pickup zone, or pickup zone on an adjacent hop). */
  zoneSlug    String      @default("YAB")
  notes       String?

  senderName     String   @default("")
  senderPhone    String   @default("")
  receiverName   String   @default("")
  receiverPhone  String   @default("")
  customerRole   CustomerRole @default(sender)
  /** Who settles the fare in cash — sender at pickup or receiver at drop-off. */
  farePayer      CustomerRole @default(sender)

  feeNgn      Int
  payoutNgn   Int
  payoutPaid  Boolean     @default(false)
  paymentMethod PaymentMethod @default(cash)
  paymentStatus PaymentStatus @default(unpaid)
  paystackReference String? @unique
  paystackRefundId String?
  /** Paystack's fee, added on top of what the customer's card paid for. */
  paymentFeeNgn Int @default(0)
  paidAt      DateTime?
  refundedAt  DateTime?
  /** Road distance pickup → dropoff, stored at quote time (km). */
  distanceKm  Float       @default(0)
  /** OSRM GeoJSON LineString for pickup → dropoff. Cached once; it does not change. */
  routeGeometry Json?
  routeDurationSeconds Int?
  /** Latest rider GPS, used for the customer's pickup then drop-off countdown. */
  riderLat    Float?
  riderLng    Float?
  riderLocationAt DateTime?

  deliveryPin String
  deliveryPinRevealedAt DateTime?
  deliveryPinRequestedAt DateTime?
  /** When the PIN was last texted to the receiver. The rider never receives it. */
  deliveryPinSentAt DateTime?
  deliveryProof String?
  deliveryProofNote String?
  deliveryProofPhotoUrl String?

  cancelReason String?

  /** When set in the future, order is paused from rider dispatch until that time. */
  scheduledFor    DateTime?
  /** @deprecated Customer reschedule delay — kept for existing rows. */
  rescheduleCount Int       @default(0)
  /** Cancel-intercept retention offer has been shown (or applied). */
  retentionOfferShown Boolean @default(false)

  /** Shop this bag belongs to. Null on a normal customer errand. */
  merchantId     String?
  merchant       Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  /** Menu total in naira. Paid to the shop directly, or by card with the delivery. Riders never collect it. */
  goodsNgn       Int       @default(0)
  /** Older card orders only: when an admin marked this order's share paid. Newer payouts are ShopPayout rows. */
  shopPaidOutAt  DateTime?
  /// Shop orders: the kind of bag (e.g. "Food pack"). Riders see this instead of the items.
  packageType    String?
  /// How many bags the shop packs for this one delivery. Riders collect all of them.
  bagCount       Int         @default(1)
  /** Null while a link order is still being packed. Shop-sent bags are ready immediately. */
  readyAt        DateTime?
  lines          OrderLine[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  completedAt DateTime?

  releases    OrderRelease[]
  events      OrderEvent[]
  refunds     Refund[]
  ledgerEntries LedgerEntry[]

  @@index([status, scheduledFor])
  @@index([zoneSlug, status, scheduledFor])
  @@index([merchantId, createdAt])
}

model OrderLine {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name     String
  qty      Int
  priceNgn Int
  /// Which bag in the delivery this line belongs to. 1 when the order is a single bag.
  bagIndex Int    @default(1)

  @@index([orderId])
}

/** Audit trail for order lifecycle (reschedule, auto-cancel, schedule activate, …). */
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/** One row each time a rider hands a job back before pickup. */
model OrderRelease {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId   String
  rider     Rider       @relation(fields: [riderId], references: [id], onDelete: Cascade)
  /** Phase the job was in when the rider dropped it. */
  phase     RiderPhase?
  reason    String
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@index([riderId, createdAt])
}

/// Item money sent to a shop. The shop is owed what its delivered card orders earned minus these.
model ShopPayout {
  id                   String   @id @default(cuid())
  merchantId           String
  merchant             Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  amountNgn            Int
  reference            String   @unique
  /// PROCESSING, SUCCESS, FAILED or REVERSED for Paystack transfers; MANUAL when an admin marked money sent another way.
  status               String
  paystackTransferCode String?
  failureReason        String?
  adminId              String
  admin                Admin    @relation(fields: [adminId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([merchantId, createdAt])
}
