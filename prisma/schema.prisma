generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  dispatching
  in_progress
  completed
  cancelled
}

enum RiderPhase {
  accepted
  en_route_pickup
  collected
  en_route_dropoff
  delivered
}

enum RiderAvailability {
  OFFLINE
  ONLINE
}

enum CustomerRole {
  sender
  receiver
}

model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Rider {
  id           String            @id @default(cuid())
  phone        String            @unique
  name         String
  approved     Boolean           @default(false)
  availability RiderAvailability @default(OFFLINE)
  createdAt    DateTime          @default(now())
  orders       Order[]
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  pinId     String?
  codeHash  String?
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

enum PushRole {
  customer
  rider
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  role      PushRole
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  @@index([userId, role])
}

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(dispatching)
  riderPhase  RiderPhase?

  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  riderId     String?
  rider       Rider?      @relation(fields: [riderId], references: [id])

  pickup      String
  pickupLat   Float
  pickupLng   Float
  dropoff     String
  dropoffLat  Float
  dropoffLng  Float
  notes       String?

  senderName     String   @default("")
  senderPhone    String   @default("")
  receiverName   String   @default("")
  receiverPhone  String   @default("")
  customerRole   CustomerRole @default(sender)

  feeNgn      Int
  payoutNgn   Int
  payoutPaid  Boolean     @default(false)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
